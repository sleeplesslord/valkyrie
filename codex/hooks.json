{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __VALKYRIE_HOOK_PATH__",
            "timeout": 10
          }
        ]
      }
    ],
